{
  "name": "@perakita/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8082",
    "start": "expo start --port 8082",
    "start:clean": "expo start --port 8082 --clear",
    "android": "expo start --port 8082 --android",
    "ios": "expo start --port 8082 --ios",
    "dev:offline": "expo start --port 8082 --offline",
    "start:offline": "expo start --port 8082 --offline",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1",
    "build:apk:eas": "eas build --platform android --profile preview --non-interactive",
    "enable:long-paths": "powershell -ExecutionPolicy Bypass -File ./scripts/enable-windows-long-paths.ps1",
    "web": "expo start --offline --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.9.1",
    "@perakita/shared": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/core": "^7.0.14",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-modules-core": "~57.0.17",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.10.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@expo/config-plugins": "57.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.11",
    "typescript": "~6.0.3"
  }
}
