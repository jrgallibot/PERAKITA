# Keep this file at the repo root (not inside apps/web or apps/mobile).

# Supabase (mobile)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web dashboard URL (mobile opens this instead of localhost)
EXPO_PUBLIC_WEB_APP_URL=https://perakita-web.vercel.app

# Supabase (web)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# RESEND_API_KEY / REPORT_FROM_EMAIL — for send-finance-report only

# Cursor Cloud Agents API — scripts/CI only (never EXPO_PUBLIC_ or NEXT_PUBLIC_)
# CURSOR_API_KEY=crsr_your-key-from-cursor.com/dashboard

# EXPO_PUBLIC_ENABLE_DEMO_SEED=true